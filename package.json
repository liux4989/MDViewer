{
  "name": "floating-toc",
  "version": "1.0.0",
  "description": "An interactive floating table of contents overlay positioned in the middle-left of the editor view for quick navigation and visual context",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "type-check": "tsc --noEmit",
    "type-check:strict": "tsc --noEmit --forceConsistentCasingInFileNames",
    "case-check": "node scripts/check-case-sensitivity.js"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "toc",
    "table-of-contents",
    "navigation"
  ],
  "author": "Floating TOC Plugin Team",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.16",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "5.29.0",
    "@typescript-eslint/parser": "5.29.0",
    "@vitejs/plugin-react": "^5.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "builtin-modules": "3.3.0",
    "esbuild": "0.17.3",
    "jsdom": "^26.1.0",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.89.0",
    "motion": "^12.23.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vitest": "^3.2.4",
    "zod": "^3.25.76"
  }
}
