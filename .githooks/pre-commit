#!/bin/sh

# Pre-commit hook to catch case sensitivity issues
echo "Running case sensitivity check..."

# Run the case sensitivity checker
npm run case-check

case_check_exit_code=$?

# Run TypeScript strict case checking
echo "Running TypeScript strict case checking..."
npm run type-check:strict

ts_exit_code=$?

# If either check failed, prevent commit
if [ $case_check_exit_code -ne 0 ] || [ $ts_exit_code -ne 0 ]; then
    echo ""
    echo "❌ Pre-commit checks failed!"
    echo "Please fix case sensitivity issues before committing."
    exit 1
fi

echo "✅ Pre-commit checks passed!"
exit 0